  m_EditorClassIdentifier: 
  CurrentIDCounter: 9
  json: "{\"Options\":[{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":2}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-65,\"yPos\":-481},\"ID\":1,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Don\u2019t
    thank me just yet. We had a deal, remember? You owe me information about the
    stolen gold of the King.\",\"parentUIDs\":[0],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":4}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-65,\"yPos\":-218},\"ID\":3,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"A
    rumor? That\u2019s all?\",\"parentUIDs\":[2],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":6}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-129,\"yPos\":3},\"ID\":5,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"I
    should\u2019ve known. Gossip and shadows. Hardly the lead I was hoping for.\",\"parentUIDs\":[4],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":8}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-88,\"yPos\":270},\"ID\":7,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Hmph.
    Well, if there\u2019s even a chance the gold is there, I\u2019d best start looking.\",\"parentUIDs\":[6],\"SpeechUID\":-1}],\"Parameters\":[],\"SpeechNodes\":[{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":1}],\"EditorInfo\":{\"isRoot\":true,\"xPos\":-106,\"yPos\":-633},\"ID\":0,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Ah,
    you\u2019ve done it! With the ramp lowered, I can finally take my horses out
    for a proper run. Been waiting all day for this. You have my thanks, detective.\",\"parentUIDs\":[],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"The
    Disgruntled Stablehand\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":1},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":3}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":157,\"yPos\":-408},\"ID\":2,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Right,
    right. I did hear something, though I can\u2019t say it\u2019s solid fact. The
    castle folk have been whispering about gold hidden somewhere in those trees yonder.
    Been a rumor for weeks now.\",\"parentUIDs\":[1],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"The
    Disgruntled Stablehand\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":1},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":5}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":225,\"yPos\":-158},\"ID\":4,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"That\u2019s
    all I\u2019ve got. No one knows if it\u2019s the King\u2019s gold or just some
    bandit\u2019s stash. Could be nothing at all.\",\"parentUIDs\":[3],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"The
    Disgruntled Stablehand\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":1},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":7}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":128,\"yPos\":77},\"ID\":6,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"You
    asked for what I knew, and I gave it. What you do with it? That\u2019s your business.\",\"parentUIDs\":[5],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"The
    Disgruntled Stablehand\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":1},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":184,\"yPos\":422},\"ID\":8,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Best
    of luck to you, detective. Just watch your step. Rumors have a way of leading
    men into trouble.\",\"parentUIDs\":[7],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"The
    Disgruntled Stablehand\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":1}]}"
