  json: "{\"Options\":[{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":2}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":464,\"yPos\":-50},\"ID\":1,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"It
    was from a man named Lord Edwin Blackwood.\",\"parentUIDs\":[0],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":4}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":422,\"yPos\":291},\"ID\":3,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"So
    the gold did not belong to the King after all\u2026 That means the real stolen
    treasure is still out there. You wouldn\u2019t happen to have any good leads,
    would you?\",\"parentUIDs\":[2],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":6}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":686,\"yPos\":342},\"ID\":5,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"A
    merchant, huh? Sounds like he values coin more than conversation.\",\"parentUIDs\":[4],\"SpeechUID\":-1},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":343,\"yPos\":636},\"ID\":8,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Noted.
    I\u2019ll see what he has to say. Thanks for the tip.\",\"parentUIDs\":[6],\"SpeechUID\":-1}],\"Parameters\":[],\"SpeechNodes\":[{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":1}],\"EditorInfo\":{\"isRoot\":true,\"xPos\":380.5,\"yPos\":-235},\"ID\":0,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"You
    cam back again Detective, so who's Gold was it, the one you found?\",\"parentUIDs\":[],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"The
    Disgruntled Stablehand\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":1},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":3}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":301,\"yPos\":122},\"ID\":2,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Lord
    Edwin Blackwood? Ha! Now there\u2019s a name I haven\u2019t heard in a while.
    My grandfather used to talk about him.\",\"parentUIDs\":[1],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"The
    Disgrunted Stablehand\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":1},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":5}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":630,\"yPos\":121},\"ID\":4,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Hmm\u2026
    if it\u2019s rumors you\u2019re after, then you should speak with the Merchant.
    He hears everything that passes through the castle gates\u2014stories, secrets,
    and plenty of lies. If anyone\u2019s caught wind of where the King\u2019s gold
    might be, it\u2019s him.\",\"parentUIDs\":[3],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"The
    Disgrunted Stablehand\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":1},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":8}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":307,\"yPos\":428},\"ID\":6,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Heh,
    you\u2019re not wrong. But offer him the right incentive, and he might just share
    what you need. Just be careful\u2014he knows the worth of information, and he
    won\u2019t give it up for free.\",\"parentUIDs\":[5],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"The
    Disgrunted Stablehand\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0}]}"
