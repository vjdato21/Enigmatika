  m_Name: 
  m_EditorClassIdentifier: 
  CurrentIDCounter: 9
  json: "{\"Options\":[{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":2}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":100,\"yPos\":-582},\"ID\":1,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"More
    than I expected. The gold was exactly where the rumors said\u2014hidden behind
    the trees in the courtyard. But it\u2019s locked in a chest. And it came with
    a note.\",\"parentUIDs\":[0],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":4}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":74,\"yPos\":-266},\"ID\":3,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Seems
    a noble hid it here, intending for his son to inherit it. No mention of a name,
    though\",\"parentUIDs\":[2],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":6}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":323,\"yPos\":-302},\"ID\":5,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Not
    yet. That\u2019s the next step\",\"parentUIDs\":[4],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":8}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":52,\"yPos\":279},\"ID\":7,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Not
    a bad idea. If the noble wanted this gold to be inherited, there\u2019s bound
    to be a record of it somewhere\",\"parentUIDs\":[6],\"SpeechUID\":-1}],\"Parameters\":[],\"SpeechNodes\":[{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":1}],\"EditorInfo\":{\"isRoot\":true,\"xPos\":104,\"yPos\":-757},\"ID\":0,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"So,
    detective, how\u2019s the investigation going? Found anything worth your trouble?\",\"parentUIDs\":[],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"The
    Disgruntled Stablehand\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":1},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":3}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":28,\"yPos\":-434},\"ID\":2,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"A
    note? From who\",\"parentUIDs\":[1],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"The
    Disgruntled Stablehand\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":1},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":5}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":148,\"yPos\":-124},\"ID\":4,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Well,
    now that\u2019s a twist. I figured if gold was stashed away, it was stolen. But
    if a noble put it there\u2026 that changes things. Any clue who this noble might
    be\",\"parentUIDs\":[3],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"The
    Disgruntled Stablehand\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":1},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":7}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":262,\"yPos\":59},\"ID\":6,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Hm.
    If you\u2019re looking for names and old family matters, I\u2019d say your best
    bet is the library. They keep records on noble families, their dealings, and\u2014if
    you\u2019re lucky\u2014maybe even where that key ended up.\",\"parentUIDs\":[5],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"The
    Disgruntled Stablehand\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":1},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":312,\"yPos\":412},\"ID\":8,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Then
    you\u2019d best get going.\",\"parentUIDs\":[7],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"The
    Disgruntled Stablehand\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0}]}"
  saveVersion: 110
