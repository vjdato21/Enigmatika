  json: '{"Options":[{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":2}],"EditorInfo":{"isRoot":false,"xPos":431,"yPos":-27},"ID":1,"ParamActions":[],"TMPFontGUID":null,"Text":"I''ve
    heard strange things about this museum. Do you know any of the stories?","parentUIDs":[0],"SpeechUID":-1},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":4}],"EditorInfo":{"isRoot":false,"xPos":690,"yPos":-116},"ID":3,"ParamActions":[],"TMPFontGUID":null,"Text":"Haunted?
    By what?","parentUIDs":[2],"SpeechUID":-1},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":6}],"EditorInfo":{"isRoot":false,"xPos":522,"yPos":317},"ID":5,"ParamActions":[],"TMPFontGUID":null,"Text":"Speaking
    of mysteries, I heard you found an interesting sketchbook earlier. What can you
    tell me about it?","parentUIDs":[4],"SpeechUID":-1},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":8}],"EditorInfo":{"isRoot":false,"xPos":405,"yPos":544},"ID":7,"ParamActions":[],"TMPFontGUID":null,"Text":"What
    do you mean?","parentUIDs":[6],"SpeechUID":-1},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":10}],"EditorInfo":{"isRoot":false,"xPos":682,"yPos":613},"ID":9,"ParamActions":[],"TMPFontGUID":null,"Text":"Hmm,
    I see. Thank you for the insight, Amelia.","parentUIDs":[8],"SpeechUID":-1}],"Parameters":[],"SpeechNodes":[{"Connections":[{"__type":"EditableOptionConnection:#DialogueEditor","Conditions":[],"NodeUID":1}],"EditorInfo":{"isRoot":true,"xPos":472.5,"yPos":-235},"ID":0,"ParamActions":[],"TMPFontGUID":null,"Text":"Hello
    there! Don''t mind me I''m just exploring the museum.","parentUIDs":[],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"Amelia
    Martinez","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":1},{"Connections":[{"__type":"EditableOptionConnection:#DialogueEditor","Conditions":[],"NodeUID":3}],"EditorInfo":{"isRoot":false,"xPos":343,"yPos":166},"ID":2,"ParamActions":[],"TMPFontGUID":null,"Text":"Oh,
    dear, where to begin? It''s steeped in history and mystery. They say the music
    box in the main hall holds the secrets of the past. Some even claim it''s haunted!","parentUIDs":[1],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"Amelia
    Martinez","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":0},{"Connections":[{"__type":"EditableOptionConnection:#DialogueEditor","Conditions":[],"NodeUID":5}],"EditorInfo":{"isRoot":false,"xPos":622,"yPos":124},"ID":4,"ParamActions":[],"TMPFontGUID":null,"Text":"Who
    knows? Perhaps a lost soul trapped in the melody. Or maybe it''s just the power
    of the music itself, evoking emotions so strong they feel supernatural.","parentUIDs":[3],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"Amelia
    Martinez","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":0},{"Connections":[{"__type":"EditableOptionConnection:#DialogueEditor","Conditions":[],"NodeUID":7}],"EditorInfo":{"isRoot":false,"xPos":214,"yPos":359},"ID":6,"ParamActions":[],"TMPFontGUID":null,"Text":"Ah
    yes, the sketchbook! I stumbled upon it in the hallway earlier. The composer''s
    artwork is quite impressive, don''t you think? Though, I can''t help but feel
    like it doesn''t quite capture the full story.","parentUIDs":[5],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"Amelia
    Martinez","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":0},{"Connections":[{"__type":"EditableOptionConnection:#DialogueEditor","Conditions":[],"NodeUID":9}],"EditorInfo":{"isRoot":false,"xPos":780,"yPos":304},"ID":8,"ParamActions":[],"TMPFontGUID":null,"Text":"Well,
    the sketchbook paints a picture of his artistic side, but it doesn''t seem to
    reflect the profound impact his relationship with Seraphina had on his life.
    There''s more to the story than just his skill with a pencil, you know?","parentUIDs":[7],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"Amelia
    Martinez","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":0},{"Connections":[],"EditorInfo":{"isRoot":false,"xPos":72,"yPos":564},"ID":10,"ParamActions":[],"TMPFontGUID":null,"Text":"Of
    course, dear. I hope you find what you''re truly searching for in this museum.
    There''s often more than meets the eye.","parentUIDs":[9],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"Amelia
    Martinez","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":0}]}'
