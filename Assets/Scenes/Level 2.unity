  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 0.19607843, g: 0.19607843, b: 0.19607843, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: 5e66e77026a31924e936fc62ef1e97b9, type: 3}
    m_FontSize: 32
    m_FontStyle: 3
    m_BestFit: 0
    m_MinSize: 2
    m_MaxSize: 80
    m_Alignment: 3
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1.3
  m_Text: "To the one who still waits,\r\n\r\nIn nights so long and dreams so deep,\r\nOne
    heart still yearns, alone to weep.\r\nFour seasons pass, yet love won\u2019t
    fade,\r\nThree whispered words, a promise made.\r\n\r\nThe answer lies where
    memories stay,\r\nNot in cloth where tears betray.\r\nSeek instead what\u2019s
    held so near,\r\nA locket\u2019s weight, love\u2019s souvenir.\r\n\r\nForever
    waiting,\r\nE."
