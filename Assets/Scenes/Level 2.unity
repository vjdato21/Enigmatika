  m_Color: {r: 0.19607843, g: 0.19607843, b: 0.19607843, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: 6dadd519fdf81d04da49f0d9eda7abda, type: 3}
    m_FontSize: 35
    m_FontStyle: 1
    m_BestFit: 0
    m_MinSize: 0
    m_MaxSize: 265
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1.3
  m_Text: "Beneath the moss-covered arch, faint grooves lined the stone\u2014as if
    something had once shifted there. A weathered lever stood to the side, untouched
    for years, its base stained with ash and chalk. Whispers etched into the wall
    spoke of \"a trial of worth before the path yields its secret.\" And deeper still,
    beyond the passage rumored to open, legends tell of a sealed relic waiting for
    the one who carries the final piece."
