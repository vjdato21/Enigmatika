  m_FontData:
    m_Font: {fileID: 12800000, guid: 52da61621a02bf443811ef0073356a53, type: 3}
    m_FontSize: 40
    m_FontStyle: 1
    m_BestFit: 0
    m_MinSize: 2
    m_MaxSize: 45
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1.2
  m_Text: "This violin is more than wood and strings\u2014it holds the last remnants
    of a love unfinished.\n\nSeraphina\u2019s laughter used to echo through these
    walls as I played. She would hum along to melodies I hadn\u2019t even written
    yet, as if she could hear them before I could. It was with this violin that I
    wrote our symphony\u2014note by note, breath by breath."
