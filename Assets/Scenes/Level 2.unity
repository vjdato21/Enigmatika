    - target: {fileID: 5475799747749791316, guid: 9b1abfa90e91dd5429a156da733c2991, type: 3}
      propertyPath: npcName
      value: EvelynQuest5
      objectReference: {fileID: 0}
    - target: {fileID: 5475799747749791316, guid: 9b1abfa90e91dd5429a156da733c2991, type: 3}
      propertyPath: conversation
      value: 
      objectReference: {fileID: 977649177}
    - target: {fileID: 5735047465690962860, guid: 9b1abfa90e91dd5429a156da733c2991, type: 3}
      propertyPath: json
      value: "{\"Options\":[{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":3}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":226,\"yPos\":-239},\"ID\":2,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"We
        need to talk. We're trapped inside the museum by a force field.\",\"parentUIDs\":[0],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":5}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":120,\"yPos\":10},\"ID\":4,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"This
        isn\u2019t a time for daydreaming! We need to figure out how to break this
        thing.\",\"parentUIDs\":[3],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":7}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-317,\"yPos\":-29},\"ID\":6,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Great!
        Which book? We need all the help we can get.\",\"parentUIDs\":[5],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":9}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":256,\"yPos\":259},\"ID\":8,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"I\u2019ll
        check it out. What\u2019s the title?\",\"parentUIDs\":[7],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":11}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":656,\"yPos\":353},\"ID\":10,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"I\u2019ll
        take that as a yes. Just try not to fall asleep while I search, okay?\",\"parentUIDs\":[9],\"SpeechUID\":-1}],\"Parameters\":[],\"SpeechNodes\":[{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":2}],\"EditorInfo\":{\"isRoot\":true,\"xPos\":153,\"yPos\":-431},\"ID\":0,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Well,
        well, another visitor. Are you here to admire the art or just to ask me about
        all the things I\u2019d rather not talk about?\",\"parentUIDs\":[],\"AdvanceDialogueAutomatically\":true,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Evelyn\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0.1,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":4}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":568,\"yPos\":-95},\"ID\":3,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Oh
        joy, just what I wanted today\u2014a magical prison. Can\u2019t we just enjoy
        the art in peace?\",\"parentUIDs\":[2],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Evelyn\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":6}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-108,\"yPos\":-196},\"ID\":5,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Ugh,
        do I have to? I was just getting cozy with my favorite painting. But fine,
        I suppose I\u2019ve read something about force fields in one of my books.\",\"parentUIDs\":[4],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Evelyn\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":8}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-63,\"yPos\":207},\"ID\":7,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"It\u2019s
        in my desk somewhere under the piles of, you know, important art stuff. If
        you can find it, maybe it\u2019ll tell us how to escape this lovely predicament.\",\"parentUIDs\":[6],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Evelyn\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":10}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":619,\"yPos\":144},\"ID\":9,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Something
        like 'Mystical Barriers and How to Ignore Them.' Very fitting, wouldn\u2019t
        you say?\",\"parentUIDs\":[8],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Evelyn\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":224,\"yPos\":447},\"ID\":11,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"No
        promises. But if I do, make sure you wake me up for the grand escape!\",\"parentUIDs\":[10],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Evelyn\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0}]}"
      objectReference: {fileID: 0}
