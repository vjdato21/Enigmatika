  m_Name: 
  m_EditorClassIdentifier: 
  text1: {fileID: 1477224989}
  text2: {fileID: 2059019884}
  textBackground1: {fileID: 97347266}
  textBackground2: {fileID: 575375632}
  cassette1Object: {fileID: 1216321941}
  cassette2Object: {fileID: 1192584200}
  rotateButton1: {fileID: 1973148916}
  rotateButton2: {fileID: 1198188645}
  confirmButtonObject: {fileID: 323819283}
  cassette1Events:
  - index: 0
    text: "Eliana gathered the musicians after hearing a rumor from the locals about
      the music box\u2019s power."
  - index: 1
    text: "Eliana felt the weight of the spirit\u2019s sorrow settle upon her heart
      as the music revealed the story of longing and loss."
  - index: 2
    text: Eliana began gathering musicians after she discovered a hidden treasure
      inside the music box.
  - index: 3
    text: The music box was stolen by a thief, and Eliana had to gather musicians
      to perform a rescue mission.
  cassette2Events:
  - index: 0
    text: Eliana was convinced that performing the symphony would unlock the treasure
      inside the box.
  - index: 1
    text: Eliana gathered the musicians because she discovered a hidden treasure
      inside the music box.
  - index: 2
    text: "Eliana realized that to calm the restless spirit, she must perform the
      symphony that the music box hinted at\u2014a melody woven from the threads
      of its past."
  - index: 3
    text: A rival curator challenged Eliana to perform a symphony that would rival
      the power of the music box.
  correctAnswer: 0100000002000000
  switchCamera: {fileID: 1483847902}
  rotateSound: {fileID: 1216321947}
  confirmSound: {fileID: 323819290}
  hiddenNoteObject: {fileID: 838895576}
