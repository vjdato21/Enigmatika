--- !u!114 &1725460536
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1725460534}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 0.19607843, g: 0.19607843, b: 0.19607843, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: 72b3f04427d020d439cb0cd9edb9fc06, type: 3}
    m_FontSize: 51
    m_FontStyle: 1
    m_BestFit: 0
    m_MinSize: 2
    m_MaxSize: 52
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1.3
  m_Text: "They say precision is the soul of music. Rubbish. Callum never needed
    precision\u2014he bled feeling into every note. I brought him a metronome once,
    hoping it would \u2018correct\u2019 the irregular tempo of his latest piece.
    He just laughed. Said it killed the spirit. Said it made the music \u2018predictable\u2019...
    mechanical.\n\n\u201CYou can\u2019t measure grief,\u201D he told me that night.
    \u201CYou can only play it.\u201D\n\nAfter Seraphina\u2019s accident, he stopped
    using any timing tools. Said the ticking made him sick. Said it reminded him
    of time lost, not time kept.\n\nI still hear that cursed ticking sometimes...
    like it\u2019s trying to mimic the rhythm of a heartbeat long stopped.\n\nIt
    wasn\u2019t long after that he left the city entirely, abandoning his studio
    for good. Said the place had become too full of ghosts, too heavy with what they
    once were. But I remember hearing that unfinished piece\u2014his symphony. Even
    now, it sometimes plays in my head, note for note. He said he\u2019d never perform
    it for anyone. Too personal. Too raw.\n\n"
