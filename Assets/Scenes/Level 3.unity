--- !u!114 &469614879
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 469614877}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 0.19607843, g: 0.19607843, b: 0.19607843, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: 5e66e77026a31924e936fc62ef1e97b9, type: 3}
    m_FontSize: 5
    m_FontStyle: 1
    m_BestFit: 0
    m_MinSize: 2
    m_MaxSize: 45
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1.3
  m_Text: "They say precision is the soul of music. Rubbish. Callum never needed
    precision\u2014he bled feeling into every note. I brought him a metronome once,
    hoping it would \u2018correct\u2019 the irregular tempo of his latest piece.
    He just laughed. Said it killed the spirit. Said it made the music \u2018predictable\u2019...
    mechanical.\n\n\u2018You can\u2019t measure grief,\u2019 he told me that night.
    \u2018You can only play it.\u2019\n\nAfter Seraphina\u2019s accident, he stopped
    using any timing tools. Said the ticking made him sick. Said it reminded him
    of time lost, not time kept.\n\nI still hear that cursed ticking sometimes...
    like it\u2019s trying to mimic the rhythm of a heartbeat long stopped"
